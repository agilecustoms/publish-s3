{
  "name": "publish-s3",
  "version": "2.2.7",
  "private": true,
  "description": "Publish (upload) files from ./s3 directory to AWS S3",
  "keywords": [
    "aws",
    "github-action",
    "publish",
    "release",
    "s3",
    "upload"
  ],
  "homepage": "https://github.com/agilecustoms/publish-s3",
  "bugs": {
    "url": "https://github.com/agilecustoms/publish-s3/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agilecustoms/publish-s3.git"
  },
  "license": "MIT",
  "author": "Alexey Chekulaev <chekulaevalexey@gmail.com> (https://github.com/laxa1986)",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "eslint *.{ts,mjs} \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run --coverage",
    "build": "ncc build src/index.ts --minify; rm dist/package.json"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@types/mime-types": "^3.0.1",
    "mime-types": "^3.0.2"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^6.0.0",
    "@testcontainers/localstack": "^12.2.1",
    "@types/node": "^24.19.2",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "updates-blocked": [
    "typescript 6.0.3 -> 7.x: TS 7 has no JS compiler API and typescript-eslint peer range is <6.1.0. Wait until typescript-eslint supports TS 7, then upgrade",
    "eslint 9 -> 10: eslint-plugin-import 2.32 peer range is eslint <= 9. Wait for its support or switch to eslint-plugin-import-x (as ev-invoice did)"
  ]
}
